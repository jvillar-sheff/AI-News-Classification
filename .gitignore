# ----------------------------------------------------
# 1. CORE PYTHON / VIRTUAL ENVIRONMENTS
# ----------------------------------------------------
.venv/
.env
ENV/
env/
venv/

# Python Cache Files
__pycache__/
*.pyc
*.pyo
*.pyd
*.pkl

# Python Build Files
build/
dist/
*.egg-info/

# ----------------------------------------------------
# 2. HEAVY ARTIFACTS (MODELS & DATA)
# ----------------------------------------------------
# We ignore these because they are hosted on Hugging Face Hub.

# Datasets
data/
/data/

# Models (Ignore ALL training outputs)
models/
/models/

# Heavy weight files (Block these everywhere)
*.bin
*.pt
*.safetensors
*.h5
*.ckpt
*.onnx

# Training Logs
lightning_logs/
runs/
wandb/

# ----------------------------------------------------
# 3. DEVELOPMENT / SYSTEM FILES
# ----------------------------------------------------
.ipynb_checkpoints/

# IDEs
.vscode/
.idea/
*.code-workspace

# System
.DS_Store
Thumbs.db

# Logs
*.log
*.out
*.err

# ----------------------------------------------------
# 4. EXCEPTIONS (WHAT TO KEEP)
# ----------------------------------------------------

# Explicitly allow the results folder (for charts and JSON)
!results/
!results/**

# Keep the requirements and app logic
!app/
!notebooks/